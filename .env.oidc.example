# Copy to a local ignored file; never commit real secrets or database URLs.
NODE_ENV=production
AUTH_MODE=oidc
SEP_AUTH_MODE=oidc
SEP_DEMO_MODE=0
DEV_AUTH_TOKENS_JSON={}
PORT=3000
DATABASE_URL=
MIGRATION_DATABASE_URL=
# Realm confirmed in entrar-con-reduniv.md and its public discovery document.
OIDC_ISSUER=https://identidad.reduniv.edu.cu/realms/reduniv-institucional
OIDC_JWKS_URL=https://identidad.reduniv.edu.cu/realms/reduniv-institucional/protocol/openid-connect/certs
OIDC_AUDIENCE=sep-api
# Proposed development client; use separate IDs for staging and production.
OIDC_AUTHORIZED_PARTY=sep-admin-dev
OIDC_ROLE_CLIENT_ID=sep-admin-dev
OIDC_ALLOWED_CLIENT_ROLES=ROLE_USER,ROLE_ADMIN
OIDC_CLIENT_ID=sep-admin-dev
OIDC_CLIENT_SECRET=
OIDC_ID_TOKEN_ALGORITHM=RS256
OIDC_ALLOW_LOOPBACK_HTTP=0
SEP_API_URL=http://127.0.0.1:3000
# Replace these example origins with the registered organization/public hosts.
SEP_ADMIN_ORIGIN=https://eventos.example.org
SEP_PUBLIC_ORIGIN=https://congreso.example.org
# 32 random bytes encoded as 64 hex characters; configure locally.
SEP_SESSION_ENCRYPTION_KEY=
# Absolute directory private to the web-server account.
SEP_SESSION_DIRECTORY=/var/lib/sep/sessions
# Local development only: fixed registered organization Host for loopback requests.
SEP_LOCAL_CONTEXT_HOST=
# Google connects directly to SEP; credentials belong to this application/environment.
SEP_GOOGLE_LOGIN_ENABLED=0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_API_AUDIENCE=sep-api
# Separate random 32-byte key in hex, shared only by SEP web and API.
GOOGLE_SESSION_SIGNING_KEY=
