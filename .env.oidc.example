# Copy to a local ignored file; never commit real secrets or database URLs.
NODE_ENV=production
AUTH_MODE=oidc
SEP_AUTH_MODE=oidc
SEP_DEMO_MODE=0
DEV_AUTH_TOKENS_JSON={}
PORT=3000
DATABASE_URL=
MIGRATION_DATABASE_URL=
# Set the exact realm issuer after consulting its public discovery document.
OIDC_ISSUER=https://identidad.reduniv.edu.cu/realms/REEMPLAZAR_REALM
OIDC_JWKS_URL=https://identidad.reduniv.edu.cu/realms/REEMPLAZAR_REALM/protocol/openid-connect/certs
OIDC_AUDIENCE=sep-api
OIDC_AUTHORIZED_PARTY=sep-admin
OIDC_CLIENT_ID=sep-admin
OIDC_CLIENT_SECRET=
OIDC_ID_TOKEN_ALGORITHM=RS256
OIDC_ALLOW_LOOPBACK_HTTP=0
SEP_API_URL=http://127.0.0.1:3000
# Replace these example origins with the registered organization/public hosts.
SEP_ADMIN_ORIGIN=https://eventos.example.org
SEP_PUBLIC_ORIGIN=https://congreso.example.org
# 32 random bytes encoded as 64 hex characters; configure locally.
SEP_SESSION_ENCRYPTION_KEY=
# Absolute directory private to the web-server account.
SEP_SESSION_DIRECTORY=/var/lib/sep/sessions
# Local development only: fixed registered organization Host for loopback requests.
SEP_LOCAL_CONTEXT_HOST=
