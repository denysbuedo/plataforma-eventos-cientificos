# Development only. npm run dev:demo provisions its own environment and random tokens.
NODE_ENV=development
AUTH_MODE=development-token
PORT=3000
# Fill with your local instance and distinct restricted/migration roles.
DATABASE_URL=
MIGRATION_DATABASE_URL=
# JSON object mapping random opaque tokens (32+ characters) to existing demo Person UUIDs.
# Never store real tokens here. Empty maps deliberately prevent API startup.
DEV_AUTH_TOKENS_JSON={}
# Optional binary directory; default on Windows: C:/Program Files/PostgreSQL/18/bin
SEP_PG_BIN=
