# Development only. npm run dev:demo provisions its own environment and random tokens.
NODE_ENV=development
AUTH_MODE=development-token
PORT=3000
# Fill with your local instance and distinct restricted/migration roles.
DATABASE_URL=
MIGRATION_DATABASE_URL=
# JSON object mapping random opaque tokens (32+ characters) to existing demo Person UUIDs.
# Never store real tokens here. Empty maps deliberately prevent API startup.
DEV_AUTH_TOKENS_JSON={}
# Optional binary directory; default on Windows: C:/Program Files/PostgreSQL/18/bin
SEP_PG_BIN=
# Web servers only. The demo launcher configures these automatically.
SEP_API_URL=http://127.0.0.1:3000
SEP_PUBLIC_ORIGIN=http://127.0.0.1:3001
SEP_ADMIN_ORIGIN=http://127.0.0.1:3002
# Enable only for the isolated local demo. The config contains server-side secrets.
SEP_DEMO_MODE=0
SEP_DEMO_CONFIG=
# Institutional OIDC uses a separate configuration; see .env.oidc.example.
SEP_AUTH_MODE=development-token
