  "info": {
    "title": "SEP API",
    "description": "Fase 0: metadatos de eventos, dominios registrados y permisos contextuales. Autenticación de desarrollo; sin soporte productivo OIDC todavía.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Token opaco de desarrollo configurado en servidor; no transporta roles."
      }
    },
    "schemas": {
      "IssueDto": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "codes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "field",
          "codes"
        ]
      },
      "ErrorDetailDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "issues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IssueDto"
            }
          }
        },
        "required": [
          "code",
          "message",
          "requestId"
        ]
      },
      "ErrorDto": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetailDto"
          }
        },
        "required": [
          "error"
        ]
      },
      "HealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "PersonDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "SessionDto": {
        "type": "object",
        "properties": {
          "person": {
            "$ref": "#/components/schemas/PersonDto"
          },
          "organizationId": {
            "type": "string",
            "format": "uuid"
          },
          "eventId": {
            "type": "object",
            "nullable": true,
            "format": "uuid"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "canRead": {
            "type": "boolean"
          },
          "canEdit": {
            "type": "boolean"
          },
          "organizationAdmin": {
            "type": "boolean"
          }
        },
        "required": [
          "person",
          "organizationId",
          "eventId",
          "roles",
          "canRead",
          "canEdit",
          "organizationAdmin"
        ]
      },
      "EventDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "organizationId": {
            "type": "string",
            "format": "uuid"
          },
          "nameEs": {
            "type": "string"
          },
          "nameEn": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "published",
              "archived"
            ]
          }
        },
        "required": [
          "id",
          "organizationId",
          "nameEs",
          "nameEn",
          "timezone",
          "status"
        ]
      },
      "EventPageDto": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EventDto"
            }
          },
          "limit": {
            "type": "number"
          },
          "offset": {
            "type": "number"
          }
        },
        "required": [
          "data",
          "limit",
          "offset"
        ]
      },
      "CreateEventDto": {
        "type": "object",
        "properties": {
          "nameEs": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "nameEn": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "timezone": {
            "type": "string",
            "example": "America/Havana"
          }
        },
        "required": [
          "nameEs",
          "nameEn",
          "timezone"
        ]
      },
      "UpdateEventDto": {
        "type": "object",
        "properties": {
          "nameEs": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "nameEn": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200,
            "pattern": "\\S"
          }
        }
      },
      "PublicEventDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nameEs": {
            "type": "string"
          },
          "nameEn": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "nameEs",
          "nameEn",
          "timezone"
        ]
      },
      "SiteContentDto": {
        "type": "object",
        "properties": {
          "acronym": {
            "type": "string",
            "maxLength": 24
          },
          "theme": {
            "type": "string",
            "enum": [
              "forest",
              "ocean"
            ]
          },
          "kickerEs": {
            "type": "string"
          },
          "kickerEn": {
            "type": "string"
          },
          "heroTitleEs": {
            "type": "string"
          },
          "heroTitleEn": {
            "type": "string"
          },
          "summaryEs": {
            "type": "string"
          },
          "summaryEn": {
            "type": "string"
          },
          "aboutEs": {
            "type": "string"
          },
          "aboutEn": {
            "type": "string"
          },
          "callEs": {
            "type": "string"
          },
          "callEn": {
            "type": "string"
          },
          "venueEs": {
            "type": "string"
          },
          "venueEn": {
            "type": "string"
          },
          "startDate": {
            "type": "string",
            "format": "date"
          },
          "endDate": {
            "type": "string",
            "format": "date"
          },
          "contactEmail": {
            "type": "string",
            "format": "email"
          },
          "topicsEs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "topicsEn": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "acronym",
          "theme",
          "kickerEs",
          "kickerEn",
          "heroTitleEs",
          "heroTitleEn",
          "summaryEs",
          "summaryEn",
          "aboutEs",
          "aboutEn",
          "callEs",
          "callEn",
          "venueEs",
          "venueEn",
          "startDate",
          "endDate",
          "contactEmail",
          "topicsEs",
          "topicsEn"
        ]
      },
      "SiteDraftDto": {
        "type": "object",
        "properties": {
          "event": {
            "$ref": "#/components/schemas/EventDto"
          },
          "content": {
            "$ref": "#/components/schemas/SiteContentDto"
          },
          "revision": {
            "type": "number"
          },
          "publishedRevision": {
            "type": "object",
            "nullable": true
          },
          "publishedAt": {
            "type": "object",
            "nullable": true,
            "format": "date-time"
          }
        },
        "required": [
          "event",
          "content",
          "revision",
          "publishedRevision",
          "publishedAt"
        ]
      },
      "SaveSiteDto": {
        "type": "object",
        "properties": {
          "revision": {
            "type": "number",
            "minimum": 0
          },
          "content": {
            "$ref": "#/components/schemas/SiteContentDto"
          }
        },
        "required": [
          "revision",
          "content"
        ]
      },
      "PublishSiteDto": {
        "type": "object",
        "properties": {
          "revision": {
            "type": "number",
            "minimum": 1
          }
        },
        "required": [
          "revision"
        ]
      },
      "PublishedSiteDto": {
        "type": "object",
        "properties": {
          "event": {
            "$ref": "#/components/schemas/PublicEventDto"
          },
          "content": {
            "$ref": "#/components/schemas/SiteContentDto"
          },
          "revision": {
            "type": "number"
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "event",
          "content",
          "revision",
          "publishedAt"
        ]
      }
    }
  }
}
