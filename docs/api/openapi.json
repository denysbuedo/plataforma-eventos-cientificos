  "info": {
    "title": "SEP API",
    "description": "Fase 0: metadatos de eventos, dominios registrados y permisos contextuales. Autenticación de desarrollo; sin soporte productivo OIDC todavía.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Token opaco de desarrollo configurado en servidor; no transporta roles."
      }
    },
    "schemas": {
      "IssueDto": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "codes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "field",
          "codes"
        ]
      },
      "ErrorDetailDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "issues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IssueDto"
            }
          }
        },
        "required": [
          "code",
          "message",
          "requestId"
        ]
      },
      "ErrorDto": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetailDto"
          }
        },
        "required": [
          "error"
        ]
      },
      "HealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "EventDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "organizationId": {
            "type": "string",
            "format": "uuid"
          },
          "nameEs": {
            "type": "string"
          },
          "nameEn": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "published",
              "archived"
            ]
          }
        },
        "required": [
          "id",
          "organizationId",
          "nameEs",
          "nameEn",
          "timezone",
          "status"
        ]
      },
      "EventPageDto": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EventDto"
            }
          },
          "limit": {
            "type": "number"
          },
          "offset": {
            "type": "number"
          }
        },
        "required": [
          "data",
          "limit",
          "offset"
        ]
      },
      "CreateEventDto": {
        "type": "object",
        "properties": {
          "nameEs": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "nameEn": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "timezone": {
            "type": "string",
            "example": "America/Havana"
          }
        },
        "required": [
          "nameEs",
          "nameEn",
          "timezone"
        ]
      },
      "UpdateEventDto": {
        "type": "object",
        "properties": {
          "nameEs": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "nameEn": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200,
            "pattern": "\\S"
          }
        }
      },
      "PublicEventDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nameEs": {
            "type": "string"
          },
          "nameEn": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "nameEs",
          "nameEn",
          "timezone"
        ]
      }
    }
  }
}
